{
  "expo": {
    "name": "SONIUM",
    "slug": "sonium",
    "scheme": "sonium",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      ["expo-image-picker", {
        "photosPermission": "SONIUM needs photo access so you can set your profile picture and share crew task proof.",
        "cameraPermission": "SONIUM uses your camera to capture proof photos for shared crew tasks."
      }],
      "expo-notifications"
    ],
    "android": {
      "package": "com.yassinmohamed.sonium",
      "versionCode": 1,
      "permissions": ["POST_NOTIFICATIONS", "VIBRATE", "RECEIVE_BOOT_COMPLETED"]
    },
    "experiments": {"typedRoutes": true}
  }
}
